#N canvas 40 40 767 574 12;
#X declare -path lib;
#X text 20 10 TALKING TREE (2019 \, Alan Tett and Abby Rinerson) \, Pure Data version. Touching a ring plays one year of Colorado Ponderosa Pine growth: the year sets the speed \, brightness \, loudness and sound \, and the five years before it set how long the echoes last. Behaviour follows docs/BEHAVIOR.md., f 90;
#X text 20 100 TEST PANEL: click a ring or press keys 1-5 on the keyboard. The strength slider sets the delay time., f 90;
#X obj 30 162 tgl 30 0 tt-tgl1-out tt-tgl1 1990 2 -8 0 12 -262144 -1 -1 0 1000;
#X obj 90 162 tgl 30 0 tt-tgl2-out tt-tgl2 1991 2 -8 0 12 -262144 -1 -1 0 1000;
#X obj 150 162 tgl 30 0 tt-tgl3-out tt-tgl3 1992 2 -8 0 12 -262144 -1 -1 0 1000;
#X obj 210 162 tgl 30 0 tt-tgl4-out tt-tgl4 1993 2 -8 0 12 -262144 -1 -1 0 1000;
#X obj 270 162 tgl 30 0 tt-tgl5-out tt-tgl5 1994 2 -8 0 12 -262144 -1 -1 0 1000;
#X obj 360 167 hsl 128 20 500 2000 0 0 tt-strength empty strength -2 -10 0 12 -262144 -1 -1 4233 1;
#X obj 530 167 tt-testpanel;
#X text 20 222 ARDUINO: click the port that matches yours. On the Pi the start script sends it. On Windows the COM number is in Device Manager., f 90;
#X msg 20 272 symbol COM3;
#X msg 170 272 symbol COM4;
#X msg 320 272 symbol /dev/ttyACM0;
#X msg 470 302 symbol /dev/ttyUSB0;
#X obj 20 342 s tt_port;
#X text 20 392 THE PIECE: settings are in tt-params. Open any box to see how that part works., f 90;
#X obj 20 432 tt-params;
#X obj 120 432 tt-load;
#X obj 220 432 tt-serial;
#X obj 320 432 tt-touch;
#X obj 420 432 tt-year;
#X obj 20 472 tt-engine~;
#X obj 20 512 dac~ 1 2;
#X obj 120 512 s~ tt-out;
