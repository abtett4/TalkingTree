#N canvas 40 40 1105 666 12;
#X text 20 10 Year lookup and mapping (BEHAVIOR.md 2). Ring N reads line yearoffset + N - 1 of tt-years: year growth memory sound. n = growth mapped to -0.5..+0.5 across the data's range., f 60;
#X obj 20 72 r tt-touch;
#X obj 20 102 expr min(max(tt_yearoffset + \$f1 - 1 \, 0) \, tt_nyears - 1);
#X obj 20 132 text get tt-years;
#X obj 20 178 t b l;
#X msg 20 588 \; tt-go bang;
#X obj 240 218 print talkingtree;
#X obj 80 218 unpack f f f s;
#X obj 560 258 s tt-sound;
#X obj 400 298 expr tt_echomin + \$f1 * (tt_echomax - tt_echomin);
#X obj 400 328 s tt-feedback;
#X obj 80 378 expr min(max((\$f1 - tt_datamin) / max(tt_datamax - tt_datamin \, 1e-06) \, 0) \, 1) - 0.5;
#X obj 80 424 expr pow(2 \, tt_speedspread * \$f1) \; min(max(1100 * pow(2 \, tt_brightspread * \$f1) \, 40) \, 16000) \; min(max(3000 * pow(2 \, tt_drybrightspread * \$f1) \, 300) \, 18000) \; tt_loudspread * \$f1;
#X obj 80 518 s tt-rate;
#X obj 210 518 s tt-cutoff;
#X obj 340 518 s tt-drycutoff;
#X obj 470 518 s tt-loud;
