#N canvas 40 40 768 624 12;
#X text 20 10 Loads the two sounds and the tree-ring data when the patch opens \, then turns audio on. Paths are relative to this lib folder., f 70;
#X obj 20 70 array define leaf2;
#X obj 200 70 array define log3;
#X obj 380 70 text define tt-years;
#X obj 580 70 text define tt-range;
#X obj 20 120 loadbang;
#X obj 20 150 t b b b b;
#X msg 380 190 read -resize -maxsize 1e+07 ../audio/leaf2.wav leaf2 \, read -resize -maxsize 1e+07 ../audio/log3.wav log3, f 40;
#X obj 380 252 soundfiler;
#X obj 250 302 t b b b;
#X msg 480 342 read ../data/years.txt;
#X msg 320 372 read ../data/range.txt;
#X obj 250 412 t b b;
#X obj 400 442 text size tt-years;
#X obj 400 472 v tt_nyears;
#X msg 250 442 0;
#X obj 250 472 text get tt-range;
#X obj 250 502 unpack f f;
#X obj 250 532 v tt_datamin;
#X obj 360 562 v tt_datamax;
#X msg 120 200 \; tt-sound symbol leaf2;
#X msg 20 250 \; pd dsp 1;
