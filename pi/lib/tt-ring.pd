#N canvas 40 40 687 414 12;
#X text 20 10 One ring (\$1 = ring number). Pass 1 reports a release \, pass 2 a new touch \, so all releases are handled before any touch (BEHAVIOR.md 4)., f 60;
#X obj 20 72 r tt-v\$1;
#X obj 150 72 r tt-pass1;
#X obj 350 72 r tt-pass2;
#X obj 150 112 f;
#X obj 350 112 f;
#X obj 150 152 expr \$f1 >= tt_threshold;
#X obj 350 152 expr \$f1 >= tt_threshold;
#X obj 150 232 expr \$f1 == 0 && \$f2 == 1;
#X obj 350 192 t f f;
#X obj 350 232 expr \$f1 == 1 && \$f2 == 0;
#X text 450 272 then remember the new state, f 60;
#X obj 20 192 expr if(\$f1 >= tt_threshold \, \$f1 \, 0);
#X obj 20 232 s tt-held;
#X obj 150 272 sel 1;
#X obj 150 312 s tt-release;
#X obj 350 272 sel 1;
#X obj 350 312 f \$1;
#X obj 350 352 s tt-touch;
#X connect 2 0 4 0;
#X connect 3 0 5 0;
#X connect 1 0 4 1;
#X connect 1 0 5 1;
#X connect 4 0 6 0;
#X connect 5 0 7 0;
#X connect 6 0 8 0;
#X connect 7 0 9 0;
#X connect 9 1 10 0;
#X connect 9 0 8 1;
#X connect 9 0 10 1;
#X connect 4 0 12 0;
#X connect 12 0 13 0;
#X connect 8 0 14 0;
#X connect 14 0 15 0;
#X connect 10 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
