#N canvas 40 40 935 596 12;
#X text 20 10 Settings. Defaults are the ones in docs/BEHAVIOR.md. Edit the numbers in the box and click it (or save and restart) to change them. Each line sends to a receiver of the same name \, which stores it in a [value] that the other parts read., f 60;
#X obj 20 88 loadbang;
#X msg 20 118 \; tt_threshold 500 \; tt_speed 213 \; tt_speedspread 2.5 \; tt_brightspread 6.9 \; tt_drybrightspread 5 \; tt_loudspread 12 \; tt_jump 35 \; tt_looplength 1000 \; tt_echomin 0.15 \; tt_echomax 0.6 \; tt_drygain -6 \; tt_delaygain -22 \; tt_master 0 \; tt_yearoffset 0;
#X obj 260 118 r tt_threshold;
#X obj 430 118 v tt_threshold;
#X text 600 118 touch threshold (raw capacitance), f 45;
#X obj 260 150 r tt_speed;
#X obj 430 150 v tt_speed;
#X text 600 150 Jump every (ms): wander clock interval, f 45;
#X obj 260 182 r tt_speedspread;
#X obj 430 182 v tt_speedspread;
#X text 600 182 octaves of playback rate across the data, f 45;
#X obj 260 214 r tt_brightspread;
#X obj 430 214 v tt_brightspread;
#X text 600 214 octaves of delay-filter cutoff, f 45;
#X obj 260 246 r tt_drybrightspread;
#X obj 430 246 v tt_drybrightspread;
#X text 600 246 octaves of dry-filter cutoff, f 45;
#X obj 260 278 r tt_loudspread;
#X obj 430 278 v tt_loudspread;
#X text 600 278 dB of loudness across the data, f 45;
#X obj 260 310 r tt_jump;
#X obj 430 310 v tt_jump;
#X text 600 310 max wander step (% of the file), f 45;
#X obj 260 342 r tt_looplength;
#X obj 430 342 v tt_looplength;
#X text 600 342 loop length (ms of the file), f 45;
#X obj 260 374 r tt_echomin;
#X obj 430 374 v tt_echomin;
#X text 600 374 feedback after lean years, f 45;
#X obj 260 406 r tt_echomax;
#X obj 430 406 v tt_echomax;
#X text 600 406 feedback after good years, f 45;
#X obj 260 438 r tt_drygain;
#X obj 430 438 v tt_drygain;
#X text 600 438 dry level (dB), f 45;
#X obj 260 470 r tt_delaygain;
#X obj 430 470 v tt_delaygain;
#X text 600 470 delay level (dB), f 45;
#X obj 260 502 r tt_master;
#X obj 430 502 v tt_master;
#X text 600 502 output level (dB), f 45;
#X obj 260 534 r tt_yearoffset;
#X obj 430 534 v tt_yearoffset;
#X text 600 534 ring N plays data year yearoffset + N - 1, f 45;
#X connect 1 0 2 0;
#X connect 3 0 4 0;
#X connect 6 0 7 0;
#X connect 9 0 10 0;
#X connect 12 0 13 0;
#X connect 15 0 16 0;
#X connect 18 0 19 0;
#X connect 21 0 22 0;
#X connect 24 0 25 0;
#X connect 27 0 28 0;
#X connect 30 0 31 0;
#X connect 33 0 34 0;
#X connect 36 0 37 0;
#X connect 39 0 40 0;
#X connect 42 0 43 0;
