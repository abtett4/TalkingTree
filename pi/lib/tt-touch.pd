#N canvas 40 40 867 674 12;
#X text 20 10 Touch logic. tt-rings carries the five ring values. Each [tt-ring] sends tt-release or tt-touch <ring>. The strongest held ring sets the delay time (BEHAVIOR.md 5)., f 60;
#X obj 20 72 r tt-rings;
#X obj 20 102 t b l l;
#X obj 300 142 unpack f f f f f;
#X obj 300 182 s tt-v1;
#X obj 370 182 s tt-v2;
#X obj 440 182 s tt-v3;
#X obj 510 182 s tt-v4;
#X obj 580 182 s tt-v5;
#X obj 20 142 t b b;
#X msg 80 182 \; tt-pass1 bang;
#X msg 20 228 \; tt-pass2 bang;
#X obj 20 288 tt-ring 1;
#X obj 110 288 tt-ring 2;
#X obj 200 288 tt-ring 3;
#X obj 290 288 tt-ring 4;
#X obj 380 288 tt-ring 5;
#X obj 160 338 expr max(max(max(max(if(\$f1 >= tt_threshold \, \$f1 \, 0) \, if(\$f2 >= tt_threshold \, \$f2 \, 0)) \, if(\$f3 >= tt_threshold \, \$f3 \, 0)) \, if(\$f4 >= tt_threshold \, \$f4 \, 0)) \, if(\$f5 >= tt_threshold \, \$f5 \, 0));
#X obj 160 416 moses 1;
#X text 260 416 0 = nothing held: keep the last delay time, f 60;
#X obj 160 456 expr min(max(100 + (\$f1 - tt_threshold) / max(2000 - tt_threshold \, 1) * 900 \, 100) \, 1000);
#X obj 160 502 expr if(abs(\$f1 - \$f2) >= 50 \, \$f1 \, -1);
#X text 560 502 dead band: ignore changes under 50 ms, f 60;
#X obj 160 542 moses 0;
#X obj 220 572 t f f;
#X obj 420 542 loadbang;
#X msg 420 572 100;
#X obj 220 612 s tt-delayms;
