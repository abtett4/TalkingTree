#N canvas 40 40 581 852 12;
#X text 20 10 Arduino input. Reads lines of 'lag ring1 ring2 ring3 ring4 ring5' (tab-separated \, 9600 baud) and sends the five ring values to tt-rings. Nothing happens until a port name arrives on tt_port. If no bytes arrive for 5 seconds it closes and reopens the port \, so the Arduino can be plugged in late or replugged., f 60;
#X obj 20 120 r tt_port;
#X obj 20 150 symbol;
#X obj 20 180 t b s;
#X obj 20 210 t b b b;
#X text 240 150 watchdog: restarted by every byte, f 60;
#X obj 240 200 delay 5000;
#X obj 110 240 symbol;
#X msg 170 240 close;
#X msg 110 300 devicename \$1;
#X obj 20 270 print tt-serial: opening;
#X text 20 340 port 99 = none: the error comport prints at load is harmless, f 60;
#X obj 110 370 comport 99 9600;
#X obj 110 410 t f b;
#X obj 110 450 sel 10 13 9;
#X msg 250 480 32;
#X msg 250 520 append \$1;
#X obj 20 520 t b b;
#X obj 110 560 list store;
#X msg 20 560 list;
#X obj 110 600 fudiparse;
#X obj 110 630 t l l;
#X obj 250 660 list length;
#X obj 250 690 == 6;
#X obj 110 720 spigot;
#X obj 110 750 list split 1;
#X obj 110 790 s tt-rings;
#X text 260 750 drop the lag value \, keep the five rings, f 60;
