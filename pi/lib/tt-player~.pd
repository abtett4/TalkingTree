#N canvas 40 40 1042 900 12;
#X text 20 10 Sample player and wander (BEHAVIOR.md 6). Each clock tick moves a random walk over the file (max step = tt_jump % of the file \, wrapping at the ends) and crossfades to a new loop there. If the loop ends before the next tick it repeats. Files are 44.1 kHz., f 60;
#X obj 700 104 r tt-rate;
#X obj 700 134 v tt_rate;
#X obj 700 174 r tt-sound;
#X obj 700 204 t s s;
#X obj 760 244 array size;
#X obj 760 274 t b;
#X obj 760 310 t f f;
#X obj 860 380 v tt_len;
#X obj 760 350 expr fmod(tt_walk \, \$f1);
#X obj 760 410 v tt_walk;
#X text 700 478 a new sound keeps the walk inside the file, f 60;
#X obj 20 104 r tt-go;
#X obj 120 104 r tt-stop;
#X obj 230 104 r tt_speed;
#X msg 20 134 1;
#X msg 120 134 0;
#X obj 20 174 metro 213;
#X text 110 174 a metro ticks as soon as it starts, f 60;
#X obj 20 214 random 10001;
#X obj 20 254 expr fmod(fmod(tt_walk + (\$f1 / 5000 - 1) * tt_jump / 100 * tt_len \, tt_len) + tt_len \, tt_len);
#X obj 20 300 t f f;
#X obj 120 330 v tt_walk;
#X obj 20 400 expr \$f1 \; max(min(tt_len - \$f1 \, tt_looplength * 44.1) \, 441) \; max(min(tt_len - \$f1 \, tt_looplength * 44.1) \, 441) / (tt_rate * 44.1);
#X obj 20 478 pack f f f s;
#X text 220 478 start length ms sound, f 60;
#X obj 20 528 t l l l;
#X obj 300 568 list;
#X obj 160 568 unpack f f f s;
#X obj 160 608 delay;
#X text 380 608 repeat the loop if it ends before the next tick, f 60;
#X msg 240 134 stop;
#X obj 20 658 list split 3;
#X obj 20 688 expr \$f1 \; \$f2 + tt_rate * 441 \; \$f3 + 10;
#X obj 20 750 pack f f f s;
#X obj 20 780 t l b;
#X obj 200 780 f;
#X obj 240 780 + 1;
#X obj 280 780 mod 2;
#X obj 200 810 t f f;
#X obj 20 840 list prepend 0;
#X obj 330 840 sel 0 1;
#X msg 330 870 stop;
#X msg 390 870 stop;
#X obj 20 870 route 0 1;
#X msg 20 900 play \$1 \$2 \$3 \$4;
